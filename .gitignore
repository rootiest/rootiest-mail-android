# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
!/android/app/debug.keystore
*.lineage

# Metro / Expo dev-server logs
.metro-health-check*
metro.log
expo.log
expo-run.log
scripts/*.log

# Scratch
tmp-*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# Android build outputs (track the project itself, not its build artifacts)
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/captures/
/android/*.iml
/android/app/*.iml
/android/build-release.log
/android/expo*.log
/android/metro.log
# the Google Play bundle scripts/release.sh leaves for Play Console
/build/play/

